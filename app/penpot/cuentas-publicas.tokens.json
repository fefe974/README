  "$themes": [
    {
      "id": "papel-claro",
      "name": "Papel de trabajo · claro",
      "group": "Cuentas Públicas",
      "selectedTokenSets": { "core": "source", "papel-de-trabajo/claro": "enabled" }
    },
    {
      "id": "papel-oscuro",
      "name": "Papel de trabajo · oscuro",
      "group": "Cuentas Públicas",
      "selectedTokenSets": { "core": "source", "papel-de-trabajo/oscuro": "enabled" }
    }
  ],

  "$metadata": {
    "tokenSetOrder": ["core", "papel-de-trabajo/claro", "papel-de-trabajo/oscuro"]
