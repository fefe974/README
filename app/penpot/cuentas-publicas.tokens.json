{
  "core": {
    "space": {
      "step": { "$value": "4", "$type": "spacing", "$description": "Unidad base de la retícula" },
      "xs": { "$value": "{space.step} * 2", "$type": "spacing" },
      "sm": { "$value": "{space.step} * 3", "$type": "spacing" },
      "md": { "$value": "{space.step} * 4", "$type": "spacing" },
      "lg": { "$value": "{space.step} * 5", "$type": "spacing" },
      "xl": { "$value": "{space.step} * 8", "$type": "spacing" }
    },
    "radius": {
      "sm": { "$value": "6", "$type": "borderRadius" },
      "md": { "$value": "10", "$type": "borderRadius" },
      "lg": { "$value": "12", "$type": "borderRadius" },
      "pill": { "$value": "999", "$type": "borderRadius" }
    },
    "stroke": {
      "hair": { "$value": "1", "$type": "borderWidth", "$description": "Reglas y separadores" },
      "mark": { "$value": "1.5", "$type": "borderWidth", "$description": "Contorno de un elemento activo" },
      "focus": { "$value": "3", "$type": "borderWidth", "$description": "Anillo de foco · WCAG 2.2" }
    },
    "font": {
      "display": { "$value": "EB Garamond", "$type": "fontFamilies", "$description": "El registro de la norma escrita" },
      "body": { "$value": "Atkinson Hyperlegible", "$type": "fontFamilies", "$description": "Tipografía del Braille Institute para baja visión: la tesis de accesibilidad hecha material" },
      "mono": { "$value": "IBM Plex Mono", "$type": "fontFamilies", "$description": "Citas normativas y cifras" }
    },
    "size": {
      "micro": { "$value": "10", "$type": "fontSizes" },
      "caption": { "$value": "13", "$type": "fontSizes" },
      "body": { "$value": "16", "$type": "fontSizes" },
      "lead": { "$value": "19", "$type": "fontSizes" },
      "title": { "$value": "27", "$type": "fontSizes" },
      "hero": { "$value": "52", "$type": "fontSizes" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeights" },
      "semibold": { "$value": "600", "$type": "fontWeights" },
      "bold": { "$value": "700", "$type": "fontWeights" }
    },
    "leading": {
      "tight": { "$value": "1.15", "$type": "lineHeights" },
      "snug": { "$value": "1.35", "$type": "lineHeights" },
      "relaxed": { "$value": "1.6", "$type": "lineHeights" }
    },
    "tracking": {
      "eyebrow": { "$value": "0.13em", "$type": "letterSpacing" },
      "normal": { "$value": "0", "$type": "letterSpacing" },
      "tight": { "$value": "-0.015em", "$type": "letterSpacing" }
    }
