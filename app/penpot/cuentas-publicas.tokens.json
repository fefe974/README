      "ink-2": { "$value": "#3E4741", "$type": "color", "$description": "8.14:1 sobre ground" },
      "muted": { "$value": "#5E685D", "$type": "color", "$description": "4.91:1 sobre ground · mínimo AA para texto" }
    },
    "line": {
      "rule": { "$value": "#CCD4C6", "$type": "color" },
      "rule-2": { "$value": "#B0BAA9", "$type": "color" }
