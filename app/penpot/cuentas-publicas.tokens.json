      "rule-2": { "$value": "#363E33", "$type": "color" }
    },
    "accent": {
      "mark": { "$value": "#9A9AF0", "$type": "color", "$description": "Índigo levantado para fondo oscuro. 7.30:1" },
      "mark-soft": { "$value": "#1E1E3A", "$type": "color" }
    },
    "state": {
      "ok": { "$value": "#5FBF97", "$type": "color" },
      "ok-soft": { "$value": "#12241C", "$type": "color" },
      "no": { "$value": "#E0866B", "$type": "color" },
      "no-soft": { "$value": "#2B1712", "$type": "color" }
